/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    qtl-liftover Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Global default params
params {
    // Input/output
    // source = the assembly the QTL intervals are currently defined on
    source_genome   = null
    target_genome   = null
    qtl_bed         = null      // chrom  start  end  qtl_id   (BED, 0-based)
    outdir          = './results'

    // Route 2 inputs (required unless --skip_miniprot)
    source_gff      = null
    source_proteins = null

    // Benchmark input (required unless --skip_benchmark)
    probes          = null

    skip_miniprot   = false
    skip_benchmark  = false

    // Route 1: minimap2 whole-genome alignment
    // asm5  ~0.1% divergence (clonal / same cultivar group)
    // asm10 ~1%   divergence (two cultivars of one crop)   <- default
    // asm20 ~5%   divergence (landrace vs wild relative)
    asm_preset      = 'asm10'
    minimap2_extra  = '-I 8G -K 4G'   // raise -I above your genome size
    n_anchor        = 200             // anchor points tiled per QTL interval
    lift_min_mapq   = 5
    lift_min_alnlen = 1000

    // Route 2: miniprot protein anchors
    gff_feature          = 'mRNA'     // or 'transcript' for GTF-style files
    gff_id_attr          = 'ID'       // must match the protein FASTA headers
    gff_strip_prefix     = false      // true for Ensembl-style 'mRNA:XYZ' IDs
    miniprot_extra       = '--outn=5'
    miniprot_min_ident   = 0.80
    miniprot_min_cov     = 0.70
    miniprot_max_second  = 0.90       // lower = stricter about paralogs
    miniprot_min_anchors = 3

    // Benchmark
    probe_preset        = 'sr'        // 50-120 bp probes; 'map-ont' if >300 bp
    probe_min_cov       = 0.90
    probe_min_ident     = 0.95
    probe_max_second    = 0.90
    bench_flank         = 0           // pad transferred intervals before scoring

    // Max resource limits
    max_memory      = '128.GB'
    max_cpus        = 16
    max_time        = '48.h'
}

// Load configs
params.custom_config_base = "."
includeConfig("nfcore_custom.config")
includeConfig("conf/containers.config")
includeConfig("conf/modules.config")

process {
    // Per-process overrides. These are top-level (NOT inside a profile), so
    // they merge with the ext.args set in conf/modules.config rather than
    // replacing it. Everything goes through check_max so --max_memory and
    // --max_cpus still win.
    //
    // Whole-genome alignment of two plant genomes is the memory hog:
    // minimap2 -I 8G holds an 8 Gb index in RAM.
    withName: 'MINIMAP2_ALIGN' {
        cpus   = { check_max( 16                  , 'cpus'   ) }
        memory = { check_max( 96.GB * task.attempt, 'memory' ) }
        time   = { check_max( 24.h  * task.attempt, 'time'   ) }
    }

    withName: 'MINIMAP2_PROBES' {
        cpus   = { check_max( 8                   , 'cpus'   ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h   * task.attempt, 'time'   ) }
    }

    withName: 'MINIPROT_INDEX' {
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
    }
}

// Container engine profiles
profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }
    singularity {
        includeConfig 'conf/profiles/singularity.config'
        docker.enabled         = false
        conda.enabled          = false
    }
    conda {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    setonix {
        includeConfig 'conf/profiles/pawsey_setonix.config'
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Workflow metadata
manifest {
    name            = 'qtl-liftover'
    homePage        = 'https://github.com/'
    description     = 'Transfer QTL intervals between varieties by whole-genome (minimap2) and protein (miniprot) alignment, benchmarked with probe sequences'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

// Tracing / reporting
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Never request more than the machine or partition actually has.
    Defined here (the parent config) so that every includeConfig'd file -
    nfcore_custom.config, conf/*.config - can call it.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            return obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1
                ? params.max_memory as nextflow.util.MemoryUnit : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            return obj.compareTo(params.max_time as nextflow.util.Duration) == 1
                ? params.max_time as nextflow.util.Duration : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj as int, params.max_cpus as int) }
        catch (all) { return obj }
    }
}
