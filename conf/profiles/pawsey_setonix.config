// Pawsey Setonix profile
def scratchDir = "/scratch/" + System.getenv('PAWSEY_PROJECT')

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${scratchDir}/singularity_cache"
    runOptions = '--bind ' + scratchDir
}

// NOTE: use `withLabel` (not `withName`) for per-process resource tweaks
// here - a profile `withName` block replaces the selector entry and wipes
// the ext.args set in conf/modules.config.
process {
    executor  = 'slurm'
    queue     = 'work'
    clusterOptions = "--account=${System.getenv('PAWSEY_PROJECT')}"
}

executor {
    queueSize = 50
}

params {
    max_cpus   = 64
    max_memory = '230.GB'
    max_time   = '24.h'
}
