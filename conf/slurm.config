// Generic Slurm executor profile
// NOTE: use `withLabel` (not `withName`) for resource tweaks in profile
// configs - a profile `withName` block replaces the selector entry and
// wipes the ext.args set in conf/modules.config.
process {
    executor = 'slurm'
    queue    = 'normal'
}

executor {
    queueSize = 50
}
