/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test profile: synthetic data built by test/make_test_data.py
      nextflow run . -profile test,conda
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    NOTE: resources here are set with `withLabel`, never `withName`.
    A `withName` block inside a profile-included config REPLACES that
    selector's whole entry and would silently wipe the ext.args set in
    conf/modules.config. See README "Config layering gotcha".
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    max_cpus   = 2
    max_memory = '4.GB'
    max_time   = '1.h'

    source_genome   = "${projectDir}/test/data/varietyA.fa"
    target_genome   = "${projectDir}/test/data/varietyB.fa"
    source_gff      = "${projectDir}/test/data/varietyA.gff3"
    source_proteins = "${projectDir}/test/data/varietyA.pep.fa"
    qtl_bed         = "${projectDir}/test/data/qtl_intervals.bed"
    probes          = "${projectDir}/test/data/probes.fa"
    outdir          = "${projectDir}/test/results"

    asm_preset      = 'asm5'
    minimap2_extra  = ''
    lift_min_alnlen = 100
}

process {
    withLabel: process_high   { cpus = 1; memory = '2.GB'; time = '20m' }
    withLabel: process_medium { cpus = 1; memory = '2.GB'; time = '20m' }
    withLabel: process_low    { cpus = 1; memory = '2.GB'; time = '20m' }
}
