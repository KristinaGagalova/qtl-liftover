/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Process parameters (ext.args)
      - MINIMAP2_ALIGN   : asm preset for whole-genome alignment
      - MINIMAP2_PROBES  : short-read preset, secondary hits REPORTED on purpose
                           so PROBE_POSITIONS can reject multi-locus probes
      - MINIPROT_ALIGN   : --outn>1 on purpose, so MINIPROT_LIFT can reject
                           paralogous anchors
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: 'MINIMAP2_ALIGN' {
        ext.args   = { "-x ${params.asm_preset} --cs --secondary=no ${params.minimap2_extra}" }
        ext.prefix = { "${meta.id}.source_to_target" }
    }

    withName: 'PAF_LIFT_BED' {
        ext.args = { [
            "--n-anchor ${params.n_anchor}",
            "--min-mapq ${params.lift_min_mapq}",
            "--min-alnlen ${params.lift_min_alnlen}"
        ].join(' ') }
        ext.prefix = { "${meta.id}.wga" }
    }

    withName: 'GFF2PROTEIN_BED' {
        ext.args = { [
            "--feature ${params.gff_feature}",
            "--id-attr ${params.gff_id_attr}",
            params.gff_strip_prefix ? '--strip-prefix' : ''
        ].join(' ') }
    }

    withName: 'MINIPROT_ALIGN' {
        ext.args = { "${params.miniprot_extra}" }
    }

    withName: 'MINIPROT_LIFT' {
        ext.args = { [
            "--min-ident ${params.miniprot_min_ident}",
            "--min-cov ${params.miniprot_min_cov}",
            "--max-second ${params.miniprot_max_second}",
            "--min-anchors ${params.miniprot_min_anchors}"
        ].join(' ') }
        ext.prefix = { "${meta.id}.miniprot" }
    }

    withName: 'MINIMAP2_PROBES' {
        ext.args   = { "-x ${params.probe_preset} -N 20 -p 0.4" }
        ext.prefix = { "probes_vs_${meta.tag}" }
    }

    withName: 'PROBE_POSITIONS' {
        ext.args = { [
            "--min-cov ${params.probe_min_cov}",
            "--min-ident ${params.probe_min_ident}",
            "--max-second ${params.probe_max_second}"
        ].join(' ') }
        ext.prefix = { "${meta.tag}" }
    }

    withName: 'PAF_LIFT_POINTS' {
        ext.args = { [
            "--min-mapq ${params.lift_min_mapq}",
            "--min-alnlen ${params.lift_min_alnlen}"
        ].join(' ') }
        ext.prefix = { "probe" }
    }

    withName: 'BENCHMARK_LIFTOVER' {
        ext.args = { "--flank ${params.bench_flank}" }
    }

}
