/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process container overrides (Galaxy depot images)
    Overrides the containers declared inside the modules.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: 'MINIMAP2_ALIGN' {
        container = 'https://depot.galaxyproject.org/singularity/minimap2:2.28--he4a0461_0'
        publishDir = [
            path: { "${params.outdir}/wga" },
            mode: 'copy'
        ]
    }

    withName: 'PAF_LIFT_BED' {
        container = 'https://depot.galaxyproject.org/singularity/python:3.10'
        publishDir = [
            path: { "${params.outdir}/wga" },
            mode: 'copy'
        ]
    }

    withName: 'GFF2PROTEIN_BED' {
        container = 'https://depot.galaxyproject.org/singularity/python:3.10'
        publishDir = [
            path: { "${params.outdir}/miniprot" },
            mode: 'copy'
        ]
    }

    withName: 'MINIPROT_INDEX' {
        container = 'https://depot.galaxyproject.org/singularity/miniprot:0.13--h577a1d6_0'
        publishDir = [
            enabled: false
        ]
    }

    withName: 'MINIPROT_ALIGN' {
        container = 'https://depot.galaxyproject.org/singularity/miniprot:0.13--h577a1d6_0'
        publishDir = [
            path: { "${params.outdir}/miniprot" },
            mode: 'copy'
        ]
    }

    withName: 'MINIPROT_LIFT' {
        container = 'https://depot.galaxyproject.org/singularity/python:3.10'
        publishDir = [
            path: { "${params.outdir}/miniprot" },
            mode: 'copy'
        ]
    }

    withName: 'MINIMAP2_PROBES' {
        container = 'https://depot.galaxyproject.org/singularity/minimap2:2.28--he4a0461_0'
        publishDir = [
            path: { "${params.outdir}/probes" },
            mode: 'copy'
        ]
    }

    withName: 'PROBE_POSITIONS' {
        container = 'https://depot.galaxyproject.org/singularity/python:3.10'
        publishDir = [
            path: { "${params.outdir}/probes" },
            mode: 'copy'
        ]
    }

    withName: 'PAF_LIFT_POINTS' {
        container = 'https://depot.galaxyproject.org/singularity/python:3.10'
        publishDir = [
            path: { "${params.outdir}/probes" },
            mode: 'copy'
        ]
    }

    withName: 'BENCHMARK_LIFTOVER' {
        container = 'https://depot.galaxyproject.org/singularity/python:3.10'
        publishDir = [
            path: { "${params.outdir}/bench" },
            mode: 'copy'
        ]
    }

}
